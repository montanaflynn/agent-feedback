{
  "name": "@agent-feedback/core",
  "version": "0.1.0",
  "description": "Framework-independent overlay, broker, and feedback payload utilities.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montanaflynn/agent-feedback.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/montanaflynn/agent-feedback#readme",
  "bugs": "https://github.com/montanaflynn/agent-feedback/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts src/server.ts --format esm --dts --clean",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  }
}
